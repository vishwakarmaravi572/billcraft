rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Business Profile Validation Helper
    function isValidBusinessProfile(data, userId) {
      return data.company is string && data.company.size() > 0 && data.company.size() <= 200
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('upi' in data) || (data.upi is string && data.upi.size() <= 100))
        && (!('ownerUid' in data) || data.ownerUid == userId);
    }

    // Bill Validation Helper
    function isValidBill(data, userId) {
      return data.billNo is string && data.billNo.size() > 0 && data.billNo.size() <= 100
        && data.company is string && data.company.size() > 0 && data.company.size() <= 200
        && data.total is number && data.total >= 0
        && (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0))
        && (!('discount' in data) || (data.discount is number && data.discount >= 0))
        && (!('items' in data) || (data.items is list && data.items.size() <= 200))
        && (!('ownerUid' in data) || data.ownerUid == userId);
    }

    // User scope: strictly isolated per user
    match /users/{userId} {
      allow get: if isOwner(userId);

      // Business Profile at users/{userId}/profile/business
      match /profile/business {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidBusinessProfile(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidBusinessProfile(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // Bills subcollection at users/{userId}/bills/{billId}
      match /bills/{billId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(billId)
          && isValidBill(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(billId)
          && isValidBill(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(billId);
      }
    }
  }
}
